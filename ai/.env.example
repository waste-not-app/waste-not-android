# Copy to ai/.env. Never commit a real key or paste it in chat.
GEMINI_API_KEY=
# Optional pool: fill 1..5. Nonempty numbered keys take priority over the legacy key above.
# Empty/duplicate keys are skipped. Keys in one Google project share its quota.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Set to a model supporting generateContent + structured output in your account.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
# Required only by the private YOLO worker. Generate a random service token.
AI_SERVICE_TOKEN=
# Separate credential for Go -> Python recommendation interface (no YOLO required).
AI_RECOMMENDATION_TOKEN=
AI_MODEL_PATH=ai/artifacts/models/yolo11n.pt
AI_DEVICE=cpu
# Keep preprocessing consistent with calibration. Existing model uses adaptive.
AI_INPUT_SHAPE=adaptive
